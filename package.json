{
  "name": "ledgerai-ph",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --out-extension:.js=.cjs --outdir=dist && node tools/copy-migrations.js",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/server/db/seed.ts",
    "electron:build": "npm run build && electron-builder install-app-deps && electron-builder --config electron-builder.json",
    "authority:gen": "tsx internal/key-generator/index.ts",
    "authority:server": "tsx internal/authority-server/index.ts",
    "authority:build": "vite build --config internal/authority-ui/vite.authority.config.ts && esbuild internal/authority-server/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist-authority/authority-server.cjs && esbuild electron/authority-main.ts electron/preload.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --out-extension:.js=.cjs --outdir=dist-authority",
    "build:installers": "node packaging/windows/build-installers.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@libsql/client": "^0.17.4",
    "@tailwindcss/vite": "^4.1.14",
    "@types/xlsx": "^0.0.36",
    "@vitejs/plugin-react": "^5.0.4",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "d3": "^7.9.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.25.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^9.0.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "supertest": "^7.2.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
