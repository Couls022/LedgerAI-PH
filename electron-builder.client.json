{
  "appId": "com.ledgerai.ph.client",
  "productName": "LedgerAI PH Client",
  "directories": {
    "output": "release-installers"
  },
  "extraMetadata": {
    "name": "ledgerai-ph-client",
    "productName": "LedgerAI PH Client",
    "version": "1.0.0",
    "main": "dist/main.cjs"
  },
  "npmRebuild": false,
  "win": {
    "target": "nsis",
    "icon": "packaging/windows/assets/app-icon.ico",
    "artifactName": "LedgerAI-PH-Client-Setup.exe"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "LedgerAI PH Client"
  },
  "files": [
    "dist/**/*",
    "package.json",
    "packaging/windows/service-config/**/*",
    "packaging/windows/assets/app-icon.ico",
    "!internal/**/*",
    "!tools/**/*",
    "!dist-authority/**/*",
    "!**/authority-main.*",
    "!**/authority-server.*",
    "!**/*.key",
    "!**/*.pem",
    "!**/*private*",
    "!**/*credentials*",
    "!**/*secret*"
  ]
}
